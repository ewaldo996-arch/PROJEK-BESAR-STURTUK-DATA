int main() {
    muatData();
    while (true) {
        tampilMenu();
        switch (bacaAngka("Pilih menu: ")) {
            case 1: tambahAnggota(); break;
            case 2: tampilAnggota(); break;
            case 3: editAnggota(); break;
            case 4: hapusAnggota(); break;
            case 5: tampilKodeQR(); break;
            case 6: catatAbsen(); break;
            case 7: absenQR(); break;
            case 8: editAbsen(); break;
            case 9: hapusAbsen(); break;
            case 10: absenHariIni(); break;
            case 11: rekapAbsensi(); break;
            case 12: rekapRentang(); break;
            case 0: cout << "Sampai jumpa!\n"; return 0;
            default: cout << "Menu tidak valid.\n";
        }
    }
}

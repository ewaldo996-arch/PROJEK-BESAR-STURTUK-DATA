#include <iostream>
#include <string>
using namespace std;

const int MAX_ANGGOTA = 100;
const int MAX_ABSENSI = 500;

// ===============================
// DATA ANGGOTA
// ===============================

struct Anggota {
    string id;
    string nama;
    string jenis;
};

Anggota anggota[MAX_ANGGOTA];
int jumlahAnggota = 0;


// ===============================
// DATA ABSENSI
// ===============================

struct Absensi {
    string id;
    string tanggal;
    string status;
};

Absensi dataAbsensi[MAX_ABSENSI];
int jumlahAbsensi = 0;


// ===============================
// TAMBAH ANGGOTA
// ===============================

void tambahAnggota() {

    if (jumlahAnggota >= MAX_ANGGOTA) {
        cout << "\nData anggota sudah penuh!\n";
        return;
    }

    cout << "\n=== TAMBAH DATA ANGGOTA ===\n";

    cout << "Masukkan ID    : ";
    cin >> anggota[jumlahAnggota].id;

    cin.ignore();

    cout << "Masukkan Nama  : ";
    getline(cin, anggota[jumlahAnggota].nama);

    cout << "Masukkan Jenis : ";
    getline(cin, anggota[jumlahAnggota].jenis);

    jumlahAnggota++;

    cout << "\nData anggota berhasil ditambahkan!\n";
}


// ===============================
// LIHAT ANGGOTA
// ===============================

void lihatAnggota() {

    cout << "\n=== DAFTAR ANGGOTA ===\n";

    if (jumlahAnggota == 0) {
        cout << "Belum ada data anggota.\n";
        return;
    }

    for (int i = 0; i < jumlahAnggota; i++) {

        cout << "\nData ke-" << i + 1 << endl;
        cout << "ID    : " << anggota[i].id << endl;
        cout << "Nama  : " << anggota[i].nama << endl;
        cout << "Jenis : " << anggota[i].jenis << endl;
    }
}


// ===============================
// EDIT ANGGOTA
// ===============================

void editAnggota() {

    string id;
    int index = -1;

    cout << "\n=== EDIT DATA ANGGOTA ===\n";
    cout << "Masukkan ID yang ingin diedit: ";
    cin >> id;

    for (int i = 0; i < jumlahAnggota; i++) {

        if (anggota[i].id == id) {
            index = i;
            break;
        }
    }

    if (index == -1) {
        cout << "Data anggota tidak ditemukan!\n";
        return;
    }

    cin.ignore();

    cout << "Nama baru  : ";
    getline(cin, anggota[index].nama);

    cout << "Jenis baru : ";
    getline(cin, anggota[index].jenis);

    cout << "\nData anggota berhasil diedit!\n";
}


// ===============================
// HAPUS ANGGOTA
// ===============================

void hapusAnggota() {

    string id;
    int index = -1;

    cout << "\n=== HAPUS DATA ANGGOTA ===\n";
    cout << "Masukkan ID yang ingin dihapus: ";
    cin >> id;

    for (int i = 0; i < jumlahAnggota; i++) {

        if (anggota[i].id == id) {
            index = i;
            break;
        }
    }

    if (index == -1) {
        cout << "Data anggota tidak ditemukan!\n";
        return;
    }

    for (int i = index; i < jumlahAnggota - 1; i++) {
        anggota[i] = anggota[i + 1];
    }

    jumlahAnggota--;

    cout << "\nData anggota berhasil dihapus!\n";
}


// ===============================
// CATAT ABSENSI
// ===============================

void catatAbsensi() {

    if (jumlahAbsensi >= MAX_ABSENSI) {
        cout << "\nData absensi sudah penuh!\n";
        return;
    }

    string id;
    int index = -1;
    int pilihan;

    cout << "\n=== CATAT ABSENSI ===\n";

    cout << "Masukkan ID anggota: ";
    cin >> id;

    for (int i = 0; i < jumlahAnggota; i++) {

        if (anggota[i].id == id) {
            index = i;
            break;
        }
    }

    if (index == -1) {
        cout << "ID anggota tidak ditemukan!\n";
        return;
    }

    cout << "Nama    : " << anggota[index].nama << endl;

    cout << "Tanggal : ";
    cin >> dataAbsensi[jumlahAbsensi].tanggal;

    cout << "\nPilih Status:\n";
    cout << "1. Hadir\n";
    cout << "2. Izin\n";
    cout << "3. Sakit\n";
    cout << "4. Alpa\n";
    cout << "Pilihan : ";
    cin >> pilihan;

    if (pilihan == 1) {
        dataAbsensi[jumlahAbsensi].status = "Hadir";
    }
    else if (pilihan == 2) {
        dataAbsensi[jumlahAbsensi].status = "Izin";
    }
    else if (pilihan == 3) {
        dataAbsensi[jumlahAbsensi].status = "Sakit";
    }
    else if (pilihan == 4) {
        dataAbsensi[jumlahAbsensi].status = "Alpa";
    }
    else {
        cout << "Pilihan tidak valid!\n";
        return;
    }

    dataAbsensi[jumlahAbsensi].id = id;

    jumlahAbsensi++;

    cout << "\nAbsensi berhasil dicatat!\n";
}


// ===============================
// LIHAT ABSENSI
// ===============================

void lihatAbsensi() {

    cout << "\n=== DAFTAR ABSENSI ===\n";

    if (jumlahAbsensi == 0) {
        cout << "Belum ada data absensi.\n";
        return;
    }

    for (int i = 0; i < jumlahAbsensi; i++) {

        string nama = "Tidak ditemukan";

        for (int j = 0; j < jumlahAnggota; j++) {

            if (anggota[j].id == dataAbsensi[i].id) {
                nama = anggota[j].nama;
                break;
            }
        }

        cout << "\nAbsensi ke-" << i + 1 << endl;
        cout << "ID       : " << dataAbsensi[i].id << endl;
        cout << "Nama     : " << nama << endl;
        cout << "Tanggal  : " << dataAbsensi[i].tanggal << endl;
        cout << "Status   : " << dataAbsensi[i].status << endl;
    }
}


// ===============================
// EDIT ABSENSI
// ===============================

void editAbsensi() {

    int nomor;

    lihatAbsensi();

    if (jumlahAbsensi == 0) {
        return;
    }

    cout << "\nMasukkan nomor absensi yang ingin diedit: ";
    cin >> nomor;

    if (nomor < 1 || nomor > jumlahAbsensi) {
        cout << "Nomor absensi tidak valid!\n";
        return;
    }

    int index = nomor - 1;
    int pilihan;

    cout << "\nTanggal baru : ";
    cin >> dataAbsensi[index].tanggal;

    cout << "\nStatus baru:\n";
    cout << "1. Hadir\n";
    cout << "2. Izin\n";
    cout << "3. Sakit\n";
    cout << "4. Alpa\n";
    cout << "Pilihan : ";
    cin >> pilihan;

    if (pilihan == 1) {
        dataAbsensi[index].status = "Hadir";
    }
    else if (pilihan == 2) {
        dataAbsensi[index].status = "Izin";
    }
    else if (pilihan == 3) {
        dataAbsensi[index].status = "Sakit";
    }
    else if (pilihan == 4) {
        dataAbsensi[index].status = "Alpa";
    }
    else {
        cout << "Pilihan tidak valid!\n";
        return;
    }

    cout << "\nData absensi berhasil diedit!\n";
}


// ===============================
// HAPUS ABSENSI
// ===============================

void hapusAbsensi() {

    int nomor;

    lihatAbsensi();

    if (jumlahAbsensi == 0) {
        return;
    }

    cout << "\nMasukkan nomor absensi yang ingin dihapus: ";
    cin >> nomor;

    if (nomor < 1 || nomor > jumlahAbsensi) {
        cout << "Nomor absensi tidak valid!\n";
        return;
    }

    int index = nomor - 1;

    for (int i = index; i < jumlahAbsensi - 1; i++) {
        dataAbsensi[i] = dataAbsensi[i + 1];
    }

    jumlahAbsensi--;

    cout << "\nData absensi berhasil dihapus!\n";
}


// ===============================
// REKAP ABSENSI
// ===============================

void rekapAbsensi() {

    int hadir = 0;
    int izin = 0;
    int sakit = 0;
    int alpa = 0;

    cout << "\n=================================\n";
    cout << "         REKAP ABSENSI\n";
    cout << "=================================\n";

    if (jumlahAbsensi == 0) {
        cout << "Belum ada data absensi.\n";
        return;
    }

    for (int i = 0; i < jumlahAbsensi; i++) {

        if (dataAbsensi[i].status == "Hadir") {
            hadir++;
        }
        else if (dataAbsensi[i].status == "Izin") {
            izin++;
        }
        else if (dataAbsensi[i].status == "Sakit") {
            sakit++;
        }
        else if (dataAbsensi[i].status == "Alpa") {
            alpa++;
        }
    }

    cout << "Total Anggota : " << jumlahAnggota << endl;
    cout << "Total Absensi : " << jumlahAbsensi << endl;
    cout << "---------------------------------\n";
    cout << "Hadir         : " << hadir << endl;
    cout << "Izin          : " << izin << endl;
    cout << "Sakit         : " << sakit << endl;
    cout << "Alpa          : " << alpa << endl;
    cout << "=================================\n";
}


// ===============================
// MENU KELOLA ANGGOTA
// ===============================

void menuAnggota() {

    int pilihan;

    do {

        cout << "\n=================================\n";
        cout << "        KELOLA ANGGOTA\n";
        cout << "=================================\n";
        cout << "1. Tambah Data Karyawan/Siswa\n";
        cout << "2. Lihat Daftar Karyawan/Siswa\n";
        cout << "3. Edit Data\n";
        cout << "4. Hapus Data\n";
        cout << "5. Kembali\n";
        cout << "=================================\n";
        cout << "Pilih menu: ";
        cin >> pilihan;

        if (pilihan == 1) {
            tambahAnggota();
        }
        else if (pilihan == 2) {
            lihatAnggota();
        }
        else if (pilihan == 3) {
            editAnggota();
        }
        else if (pilihan == 4) {
            hapusAnggota();
        }
        else if (pilihan == 5) {
            cout << "Kembali ke menu utama.\n";
        }
        else {
            cout << "Pilihan tidak valid!\n";
        }

    } while (pilihan != 5);
}


